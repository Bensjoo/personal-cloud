      "updated": 1751993814069,
      "link": null,
      "locked": false,
      "text": "App frontend data sync\n- drag & drop?\n- choose file based on \n  location with some instructions?\n\n\n             needs constraints:\n                - file format\n                - file size\n\n             needs security:\n                - Discord/Goog auth?",
      "fontSize": 36,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "App frontend data sync\n- drag & drop?\n- choose file based on \n  location with some instructions?\n\n\n             needs constraints:\n                - file format\n                - file size\n\n             needs security:\n                - Discord/Goog auth?",
      "autoResize": false,
      "lineHeight": 1.25
    },
