    {
      "id": "0rMhEMfedJYZV6E5mYs6g",
      "type": "text",
      "x": -252.2350991709252,
      "y": 6960.297418435795,
      "width": 1145.3418287942397,
      "height": 568.989165289552,
      "angle": 0,
      "strokeColor": "#868e96",
      "backgroundColor": "#b2f2bb",
      "fillStyle": "solid",
      "strokeWidth": 4,
