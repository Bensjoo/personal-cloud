                "color": "text",
                "value": null
              },
              {
                "color": "#fab219",
                "value": 1
              }
            ]
          },
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value",
        "orientation": "vertical",
        "justifyMode": "center",
        "wideLayout": true
      }
    },
