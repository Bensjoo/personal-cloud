{
  "uid": "vandelay-overview",
  "title": "Vandelay / Overview",
  "description": "High-level cluster view: temps, usage, k8s allocation, Longhorn. Details in Vandelay / Thermals & Power.",
  "tags": [
    "vandelay",
    "overview"
  ],
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 1,
  "refresh": "1m",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "schemaVersion": 39,
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Data source",
        "type": "datasource",
        "query": "prometheus",
        "current": {
          "text": "Prometheus",
          "value": "prometheus"
        },
        "hide": 0
      }
    ]
  },
  "links": [
    {
      "type": "dashboards",
      "tags": [
        "vandelay"
      ],
      "asDropdown": false,
      "includeVars": false,
      "keepTime": true,
      "title": "Vandelay"
    }
  ],
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Hottest CPU",
      "description": "Highest CPU package temp right now, and which node. TjMax 105\u00b0C.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "topk(1, max by (instance) (node_hwmon_temp_celsius{chip=\"platform_coretemp_0\", sensor=\"temp1\"}) * on(instance) group_left(nodename) node_uname_info)",
          "legendFormat": "{{nodename}}",
          "refId": "A",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "celsius",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              },
              {
                "color": "#fab219",
                "value": 85
              },
              {
                "color": "#d03b3b",
                "value": 95
              }
            ]
          },
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value_and_name",
        "orientation": "vertical",
        "justifyMode": "center",
        "wideLayout": true
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Hottest NVMe",
      "description": "Highest NVMe Composite right now, and which node. P3 4TB warns at 84\u00b0C, SN850X at 89\u00b0C.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 4,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "topk(1, max by (instance) (node_hwmon_temp_celsius{chip=~\"nvme.*\", sensor=\"temp1\"}) * on(instance) group_left(nodename) node_uname_info)",
          "legendFormat": "{{nodename}}",
          "refId": "A",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "celsius",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              },
              {
                "color": "#fab219",
                "value": 84
              },
              {
                "color": "#d03b3b",
                "value": 94
              }
            ]
          },
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value_and_name",
        "orientation": "vertical",
        "justifyMode": "center",
        "wideLayout": true
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Cluster CPU busy",
      "description": "Across all 16 cores (4 nodes x 4).",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 8,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "1 - avg(rate(node_cpu_seconds_total{mode=\"idle\"}[$__rate_interval]))",
          "legendFormat": "all nodes",
          "refId": "A",
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          },
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value",
        "orientation": "vertical",
        "justifyMode": "center",
        "wideLayout": true
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Cluster RAM in use",
      "description": "MemTotal - MemAvailable summed over the nodes: what processes hold, page cache excluded. ~125 GiB total.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum((node_memory_MemTotal_bytes - node_memory_MemAvailable_bytes))",
          "legendFormat": "all nodes",
          "refId": "A",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          },
          "decimals": 1
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value",
        "orientation": "vertical",
        "justifyMode": "center",
        "wideLayout": true
      }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Volumes not healthy",
      "description": "Longhorn volumes degraded or faulted. Detached volumes report 'unknown' and aren't counted.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 16,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum(longhorn_volume_robustness{state=~\"degraded|faulted\"}) or vector(0)",
          "legendFormat": "volumes",
          "refId": "A",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
